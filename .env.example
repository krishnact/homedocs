STACK_NAME=paperless
BIND_ADDRESS=127.0.0.1
PAPERLESS_PORT=8000
AI_PORT=3000
PAPERLESS_URL=http://localhost:8000
TZ=America/New_York
PUID=1000
PGID=1000
POSTGRES_VERSION=18
REDIS_VERSION=7-alpine
PAPERLESS_VERSION=latest
TIKA_VERSION=latest
GOTENBERG_VERSION=8
PAPERLESS_AI_VERSION=latest
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=CHANGE_ME
PAPERLESS_SECRET_KEY=CHANGE_ME
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_EMAIL=admin@localhost
PAPERLESS_ADMIN_PASSWORD=CHANGE_ME
PAPERLESS_API_TOKEN=CHANGE_ME
OCR_LANGUAGE=eng
TASK_WORKERS=2
THREADS_PER_WORKER=1
BACKUP_INTERVAL=86400
BACKUP_REMOTE=opendrive-crypt:paperless-backup
DEGOO_EMAIL=
DEGOO_PASSWORD=
DEGOO_REMOTE=/Web/paperless-backup

# Paperless-AI. Uncomment one block, set the key, then run ./init.sh.
# init.sh copies it to storage/ai/.env. Leave these commented to use the UI.

# OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Grok (xAI). Paperless-AI calls this the custom provider.
# AI_PROVIDER=custom
# CUSTOM_BASE_URL=https://api.x.ai/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=grok-4

# Claude
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# OpenRouter. CUSTOM_MODEL is the OpenRouter model id.
# AI_PROVIDER=custom
# CUSTOM_BASE_URL=https://openrouter.ai/api/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=openai/gpt-4o-mini
